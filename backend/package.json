{
  "name": "miniworld-backend",
  "version": "1.0.0",
  "description": "Backend event indexer and REST API for MiniWorld game",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx migrations/run.ts",
    "test": "tsx --test --test-concurrency=1 \"tests/saas/*.test.ts\"",
    "test:mutation": "tsx scripts/saas-mutation-check.ts",
    "saas:migrate": "sequelize-cli db:migrate",
    "saas:seed": "sequelize-cli db:seed:all"
  },
  "keywords": [
    "blockchain",
    "gaming",
    "web3",
    "event-indexer"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "ethers": "^6.13.7",
    "express": "^5.1.0",
    "ioredis": "^6.0.0",
    "mongodb": "^7.7.0",
    "pg": "^8.13.1",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.15.5",
    "sequelize-cli": "^6.6.5",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
